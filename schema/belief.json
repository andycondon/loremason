{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/andycondon/loremason/schema/belief.json",
  "title": "belief",
  "description": "A claim, with the evidence for and against it.",
  "type": "object",
  "required": [
    "id",
    "title",
    "created",
    "claim",
    "status",
    "asserted_by"
  ],
  "properties": {
    "id": {
      "$ref": "common.json#/$defs/id"
    },
    "title": {
      "$ref": "common.json#/$defs/line"
    },
    "claim": {
      "$ref": "common.json#/$defs/text"
    },
    "status": {
      "enum": [
        "held",
        "incorrect",
        "insufficient",
        "withdrawn"
      ]
    },
    "asserted_by": {
      "enum": [
        "person",
        "agent"
      ]
    },
    "support": {
      "description": "a list of support links",
      "type": "array",
      "items": {
        "description": "a map with id, evidence, direction",
        "type": "object",
        "required": [
          "id",
          "evidence",
          "direction"
        ],
        "properties": {
          "id": {
            "$ref": "common.json#/$defs/local_id"
          },
          "evidence": {
            "$ref": "common.json#/$defs/ref"
          },
          "direction": {
            "enum": [
              "supports",
              "disputes"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "answers": {
      "$ref": "common.json#/$defs/links"
    },
    "mentions": {
      "$ref": "common.json#/$defs/links"
    },
    "created": {
      "$ref": "common.json#/$defs/date"
    },
    "aliases": {
      "$ref": "common.json#/$defs/aliases"
    },
    "revisions": {
      "description": "a list of revisions",
      "type": "array",
      "items": {
        "description": "a map with rev",
        "type": "object",
        "required": [
          "rev"
        ],
        "properties": {
          "rev": {
            "type": "integer",
            "minimum": 1
          },
          "date": {
            "$ref": "common.json#/$defs/date"
          },
          "fp": {
            "$ref": "common.json#/$defs/fingerprint"
          },
          "change": {
            "$ref": "common.json#/$defs/change"
          },
          "claim": {
            "$ref": "common.json#/$defs/text"
          }
        },
        "additionalProperties": false
      }
    },
    "extra": {
      "$ref": "common.json#/$defs/extra"
    }
  },
  "additionalProperties": false
}
