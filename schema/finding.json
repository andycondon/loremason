{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/andycondon/loremason/schema/finding.json",
  "title": "finding",
  "description": "A document we wrote, such as a survey or an analysis. The body is the document.",
  "type": "object",
  "required": [
    "id",
    "title",
    "created"
  ],
  "properties": {
    "id": {
      "$ref": "common.json#/$defs/id"
    },
    "title": {
      "$ref": "common.json#/$defs/line"
    },
    "generated_by": {
      "$ref": "common.json#/$defs/single_link"
    },
    "attributed_to": {
      "$ref": "common.json#/$defs/links"
    },
    "mentions": {
      "$ref": "common.json#/$defs/links"
    },
    "created": {
      "$ref": "common.json#/$defs/date"
    },
    "aliases": {
      "$ref": "common.json#/$defs/aliases"
    },
    "revisions": {
      "description": "a list of revisions",
      "type": "array",
      "items": {
        "description": "a map with rev",
        "type": "object",
        "required": [
          "rev"
        ],
        "properties": {
          "rev": {
            "type": "integer",
            "minimum": 1
          },
          "date": {
            "$ref": "common.json#/$defs/date"
          },
          "fp": {
            "$ref": "common.json#/$defs/fingerprint"
          },
          "change": {
            "$ref": "common.json#/$defs/change"
          },
          "commit": {
            "$ref": "common.json#/$defs/commit"
          }
        },
        "additionalProperties": false
      }
    },
    "extra": {
      "$ref": "common.json#/$defs/extra"
    }
  },
  "additionalProperties": false
}
